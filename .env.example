# ==============================================================================
# PT INDONESIA THAI SUMMIT PLASTECH (ITSP) - CORE FASTAPI BACKEND
# ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# --- APPLICATION ENVIRONMENT ---
PROJECT_NAME="PT ITSP Core Backend"
ENVIRONMENT="development"  # Options: development, staging, production
DEBUG=False
VERSION="1.0.0"

# --- SECURITY & JWT ---
# WAJIB via env di production: minimal 32 karakter acak. Tanpa default di code.
# Contoh generate: openssl rand -hex 32
SECRET_KEY="change-me-min-32-chars-via-env"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 jam untuk sesi kerja HR / Admin
APPLICANT_TOKEN_EXPIRE_MINUTES=180 # 3 jam untuk sesi ujian pelamar

# --- CORS SETTINGS (Origins yang diizinkan mengakses API) ---
# Format: JSON array string — 100% via env, tanpa daftar domain hardcoded di code.
# Contoh lokal: BACKEND_CORS_ORIGINS='["http://localhost:3008","http://localhost:3009"]'
# Contoh produksi: BACKEND_CORS_ORIGINS='["https://itsp.co.id","https://karir.itsp.co.id"]'
BACKEND_CORS_ORIGINS='["http://localhost:3008","http://localhost:3009"]'

# --- DATABASE POSTGRESQL ---
# WAJIB via env. Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
# Tanpa kredensial contoh di file ini — isi dari secret manager / .env lokal (git-ignored).
DATABASE_URL="postgresql+psycopg://USER:PASSWORD@localhost:5432/web_karir"
DATABASE_COMPANY_URL="postgresql+psycopg://USER:PASSWORD@localhost:5432/web_perusahaan"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- SENTRY MONITORING ---
# Biarkan kosong jika development lokal tanpa Sentry
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# --- RATE LIMITING ---
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_PUBLIC="60/minute"

# --- CORPORATE EMAIL (SMTP / ZIMBRA / GMAIL) ---
# WAJIB via env. Tanpa kredensial asli di file contoh — isi dari secret manager / .env lokal.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="PT ITSP Recruitment Center"
SMTP_TLS=True
SMTP_SSL=False

# --- PORTAL URLS (Digunakan pada template email undangan) ---
# 100% via env — ganti domain cukup sentuh .env, tanpa ubah code.
FRONTEND_COMPANY_URL="http://localhost:3008"
FRONTEND_CAREER_URL="http://localhost:3009"

# --- GRAFANA OTLP TELEMETRY ---
# 100% via env — tanpa URL/token hardcoded di code. Kosongkan bila tidak dipakai (no-op).
GRAFANA_OTLP_URL=""
GRAFANA_AUTH_HEADER=""
