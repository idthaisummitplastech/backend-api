# ==============================================================================
# PT INDONESIA THAI SUMMIT PLASTECH (ITSP) - CORE FASTAPI BACKEND
# ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# --- APPLICATION ENVIRONMENT ---
PROJECT_NAME="PT ITSP Core Backend"
ENVIRONMENT="development"  # Options: development, staging, production
DEBUG=False
VERSION="1.0.0"

# --- SECURITY & JWT ---
# Ganti dengan string acak aman (minimal 32 karakter) di production
SECRET_KEY="pt-itsp-recruitment-ats-enterprise-jwt-secret-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 jam untuk sesi kerja HR / Admin
APPLICANT_TOKEN_EXPIRE_MINUTES=180 # 3 jam untuk sesi ujian pelamar

# --- CORS SETTINGS (Origins yang diizinkan mengakses API) ---
# Format: JSON array string
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://itsp.co.id","https://karir.itsp.co.id"]

# --- DATABASE POSTGRESQL ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="postgresql+psycopg://sydit:syditsp@localhost:5432/web_karir"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- SENTRY MONITORING ---
# Biarkan kosong jika development lokal tanpa Sentry
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# --- RATE LIMITING ---
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_PUBLIC="60/minute"

# --- CORPORATE EMAIL (SMTP / ZIMBRA / GMAIL) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="rifqi.alfaridzi22@gmail.com"
SMTP_PASS="cfqvmodphcpmhucn"
SMTP_FROM_EMAIL="rifqi.alfaridzi22@gmail.com"
SMTP_FROM_NAME="PT ITSP Recruitment Center"
SMTP_TLS=True
SMTP_SSL=False

# --- PORTAL URLS (Digunakan pada template email undangan) ---
FRONTEND_COMPANY_URL="http://localhost:3000"
FRONTEND_CAREER_URL="http://localhost:3001"
